+subtest 'request timing is collected only with access logging enabled' => sub {
+    for my $logging (0, 1) {
+        my $clock_reads = 0;
+        my $gettimeofday = \&PAGI::Server::Connection::gettimeofday;
+        no warnings 'redefine';
+        local *PAGI::Server::Connection::gettimeofday = sub {
+            ++$clock_reads;
+            return $gettimeofday->(@_);
+        };
+        my $log_output = '';
+        open my $log_fh, '>', \$log_output or die "Cannot open log: $!";
+        my $server = PAGI::Server->new(
+            app => async sub {
+                my ($scope, $receive, $send) = @_;
+                die 'Unsupported scope' unless $scope->{type} eq 'http';
+                await $loop->delay_future(after => 0.01);
+                await $send->({type => 'http.response.start', status => 200, headers => []});
+                await $send->({type => 'http.response.body', body => 'OK'});
+            },
+            host => '127.0.0.1', port => 0, quiet => 1,
+            access_log => $logging ? $log_fh : undef,
+            access_log_format => '%D',
+        );
+        $loop->add($server);
+        $server->listen->get;
+        my $http = Net::Async::HTTP->new;
+        $loop->add($http);
+        for (1 .. 2) {
+            my $response = $http->GET('http://127.0.0.1:' . $server->port . '/')->get;
+            is($response->content, 'OK', 'response unchanged');
+        }
+        $loop->remove($http);
+        $server->shutdown->get;
+        $loop->remove($server);
+        close $log_fh;
+        my @durations = grep { /\S/ } split /\n/, $log_output;
+        is($clock_reads, $logging ? 2 : 0, 'timestamp collection follows logging');
+        is(scalar @durations, $logging ? 2 : 0, 'one duration per logged request');
+        like($_, qr/\A[1-9][0-9]*\z/, 'logged request retains a measured duration') for @durations;
+    }
+};
+
